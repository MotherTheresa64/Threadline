{
  "name": "threadline",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.16.0 <25"
  },
  "scripts": {
    "dev": "concurrently \"vite\" \"tsx watch server/index.ts\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "verify:build": "node scripts/verify-build.mjs",
    "smoke:server": "node scripts/smoke-server.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:rules": "firebase emulators:exec --only firestore --project threadline-test \"vitest run tests/firestore.rules.test.ts\"",
    "test": "npm run test:unit && npm run test:rules",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium firefox webkit",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run verify:build",
    "start": "node dist-server/index.js"
  },
  "dependencies": {
    "express": "5.1.0",
    "firebase": "12.2.1",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.62.1",
    "@types/express": "5.0.3",
    "@types/node": "24.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.2",
    "concurrently": "9.2.1",
    "eslint": "10.9.1",
    "firebase-tools": "15.28.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.69.0",
    "vite": "7.1.3",
    "vitest": "4.1.11"
  }
}
